@page "/importarfaturas"
@using BlazorFatura.Data
@using BlazorFatura.Models
@using BlazorFatura.Services
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject ApplicationDbContext _context
@inject XmlService xmlService

<h3>Importar Faturas</h3>

<button @onclick="btnImportarFaturas">Importar Faturas</button>

@if (!string.IsNullOrEmpty(mensagemImportacao))
{
    <p>@mensagemImportacao</p>
}

@code {
    private string mensagemImportacao = string.Empty;

    private async Task btnImportarFaturas()
    {
        try
        {
            var result = await xmlService.ImportarFaturas();
            var sucesso = result.Where(r => r.Value).Select(r => r.Key).ToList();
            var falhas = result.Where(r => !r.Value).Select(r => r.Key).ToList();

            if (sucesso.Any())
            {
                mensagemImportacao = "Faturas importadas com sucesso: " + string.Join(", ", sucesso) + ".";
            }

            if (falhas.Any())
            {
                mensagemImportacao += "\nOcorreram erros ao importar as seguintes faturas: " + string.Join(", ", falhas) + ".";
            }
        }
        catch (Exception ex)
        {
            mensagemImportacao = $"Erro ao importar faturas: {ex.Message}";
        }
    }
}