@page "/importarfaturas"
@using BlazorFatura.Data
@using BlazorFatura.Models
@using BlazorFatura.Services
@using Microsoft.Extensions.Configuration
@using System.IO
@inject IConfiguration Configuration
@inject ApplicationDbContext _context
@inject XmlService xmlService

<h3>Importar Faturas</h3>

<button @onclick="btnImportarFaturas">Importar Faturas</button>

@if (!string.IsNullOrEmpty(mensagemImportacao))
{
    <p>@mensagemImportacao</p>
}

@code {
    private string mensagemImportacao=string.Empty;

    private async Task btnImportarFaturas()
    {
        try
        {
            var result = await xmlService.ImportarFaturas();

            foreach (var resultItem in result)
            {
                if (resultItem.Value && mensagemImportacao.Contains("Faturas"))
                {
                    mensagemImportacao = "Faturas importadas com sucesso.";
                }
                else if (!resultItem.Value && !mensagemImportacao.Contains("Ocorreram"))
                {
                    mensagemImportacao = "Ocorreram erros ao importar fatura: ";
                }

                mensagemImportacao += resultItem.Value ? " " : $" {resultItem.Key}{Environment.NewLine} ";
            }
        }
        catch (Exception ex)
        {
            mensagemImportacao = $"Erro ao importar faturas: {ex.Message}";
        }
    }
}